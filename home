<!DOCTYPE html>
<html>
<head>
    <title>Учебный проект по HTML</title>
    <style>
        body { font-family: sans-serif; background: #f0f0f0; padding: 20px; }
        #chat { height: 300px; border: 1px solid #ccc; background: #fff; overflow-y: scroll; margin-bottom: 10px; padding: 10px; }
        input { width: 80%; padding: 10px; }
        button { padding: 10px; }
    </style>
</head>
<body>
    <h3>Лабораторная работа №1: Работа с формами</h3>
    <div id="chat"></div>
    <input type="text" id="msg" placeholder="Введите текст...">
    <button onclick="send()">Отправить</button>

    <script>
        // Тут будет логика отправки в Firebase
        function send() {
            const text = document.getElementById('msg').value;
            const chat = document.getElementById('chat');
            chat.innerHTML += "<div><b>Я:</b> " + text + "</div>";
            document.getElementById('msg').value = '';
        }
    </script>
</body>
</html>
